# Gateway uploader settings -- TEMPLATE. No real credentials in this file.
#
# Copy to ".env" beside this file and fill in the blanks from the gateway
# configuration reference (SRPL/CFG/2026-27/001, marked CONFIDENTIAL). The
# filled copy is ignored by .gitignore and must stay that way: a credentials
# file has reached GitHub from this project once already.

# --- MQTT source -------------------------------------------------------------
# The 50 kSPS PLC project publishes to the LOCAL Mosquitto broker, not to
# broker.hivemq.com, which the older 25 kSPS project used. If this does not
# match what the PLC publishes to, the uploader connects, subscribes, and then
# receives nothing at all -- with no error to tell you so.
MQTT_BROKER=127.0.0.1
MQTT_PORT=1883
MQTT_TOPIC=Vibration_Data
MQTT_QOS=1

# Mosquitto on the gateway currently runs with allow_anonymous and no password
# file, so these are accepted without being checked. Set them anyway: the day a
# password file is introduced the uploader keeps working instead of silently
# dropping off.
MQTT_USERNAME=
MQTT_PASSWORD=

# --- Sensor identity ---------------------------------------------------------
# The gateway MAC, as registered with Senvia.
SENSOR_ID=

# --- What the stored numbers physically are ----------------------------------
# The PLC already converts to g:  counts x (5 V / 32768) / sensitivity -> g
# So the CSV values are ACCELERATION IN g -- not volts, not raw counts. Nothing
# downstream recorded this before, which is why no severity zone could honestly
# be assigned to a reading.
SAMPLE_UNIT=g

# Sensitivity is NOT uniform across channels on this hardware, and the Senvia
# cloud configuration reports a single value for all eight, which is wrong for
# the first two. Take the real per-channel figures from the GVL in the gateway
# configuration reference and list them here in channel order, in mV/g.
SENSITIVITY_MV_PER_G=
